# Display Settings
FONT_FAMILY=Serif
FONT_SIZE=64
TEXT_COLOR=white
TEXT_BG_COLOR=rgba(0, 0, 0, 0.5)
FULLSCREEN=true

# Metadata Settings (photos taken on/after this date get no caption)
METADATA_CUTOFF_DATE=2026-08-10

# Slideshow Defaults
DEFAULT_SPEED=7
MIN_SPEED=0.5
MAX_SPEED=30

# Initial Preferences
DEFAULT_PLAYBACK_MODE=random_all
ENABLED_TEMPLATES=template_2photo_side_by_side,template_3photo_grid,template_4photo_grid,template_big_and_two_small,template_full_bleed,template_horizontal_split,template_polaroid,template_two_stacked_wide,template_vertical_focus,template_wide_cinematic

# Template designer
DESIGNER_PORT=5000
